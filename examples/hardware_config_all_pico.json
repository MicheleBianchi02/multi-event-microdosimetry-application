{
    "schema_version": "1.0",
    "devices": {
        "pico_1": {
            "name": "Pico 2 \u2014 all roles",
            "driver": "pico_serial_v1",
            "firmware_version": "2.5",
            "connection": {
                "type": "serial",
                "baud_rate": 115200
            },
            "note": "Firmware PICO2DAQ 2.5. No port here: auto-connect opens /dev/atomiqa/pico_1, the udev rule (SYMLINK+=\"atomiqa/pico_1\") creates it. Pin map: GP14 reset, GP15 ramp trigger, GP16 event mode, GP17-19 capacitor bits, GP26 ADC (0-3.3 V).",
            "capabilities": {
                "timing": {
                    "integration_time_us": {
                        "min": 5,
                        "max": 10000000,
                        "step": 1
                    },
                    "reset_time_us": {
                        "min": 5,
                        "max": 10000000,
                        "step": 1
                    },
                    "period_us": null,
                    "ramp_sampling": {
                        "supported": true,
                        "dt_us": {
                            "min": 1,
                            "max": 10000000,
                            "step": 1
                        }
                    }
                },
                "gain": {
                    "pins": [
                        17,
                        18,
                        19
                    ],
                    "note": "Same 3 pins routed to both boards (ganged gains)."
                },
                "acquisition": {
                    "num_channels": 1,
                    "adc": {
                        "bits": 12,
                        "input_ranges_volts": [
                            {
                                "min_volts": 0.0,
                                "max_volts": 3.3
                            }
                        ],
                        "supports_oversampling": false
                    }
                }
            }
        }
    },
    "circuits": {
        "board_ch1": {
            "name": "Integrator board \u2014 detector 1",
            "model": "ATOMIQA integrator rev. B",
            "fixed_capacitance_pF": 22.0,
            "switchable_capacitors": [
                {
                    "id": "c100",
                    "value_pF": 100.0
                },
                {
                    "id": "c560",
                    "value_pF": 560.0
                },
                {
                    "id": "c3300",
                    "value_pF": 3300.0
                }
            ],
            "note": "S/N 004, connector J3."
        },
        "board_ch2": {
            "name": "Integrator board \u2014 detector 2",
            "model": "ATOMIQA integrator rev. B",
            "fixed_capacitance_pF": 0.0,
            "switchable_capacitors": [
                {
                    "id": "c100",
                    "value_pF": 100.0
                }
            ],
            "note": "S/N 005. No fixed capacitance mounted."
        }
    },
    "channels": {
        "ch1": {
            "circuit": "board_ch1"
        }
    },
    "roles": {
        "timing": "pico_1",
        "acquisition": "pico_1",
        "gain_ch1": "pico_1"
    },
    "connections": [
        {
            "device": "pico_1",
            "pin": 17,
            "circuit": "board_ch1",
            "capacitor": "c100"
        },
        {
            "device": "pico_1",
            "pin": 18,
            "circuit": "board_ch1",
            "capacitor": "c560"
        },
        {
            "device": "pico_1",
            "pin": 19,
            "circuit": "board_ch1",
            "capacitor": "c3300"
        }
    ]
}

                "gain": {
                    "pins": [
                        17,
                        18,
                        19
                    ]
                },
                "acquisition": {
                    "num_channels": 1,
                    "adc": {
                        "bits": 12,
                        "input_ranges_volts": [
                            {
                                "min_volts": 0.0,
                                "max_volts": 3.3
                            }
                        ],
                        "supports_oversampling": false
                    }
                }
            }
        }
    },
    "circuits": {
        "circuit": {
            "name": "New circuit",
            "fixed_capacitance_pF": 22.0,

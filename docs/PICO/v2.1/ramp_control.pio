.program ramp_control
.side_set 1 ; Side-set bit 0 controls PIN_RESET (1 = INTEGRATE / HIGH, 0 = RESET / LOW)

; Initialization: Core 0 pushes (Reset_Cycles - 1) then (Pulse_Count - 1) to TX FIFO
    pull block          side 0  ; Pull Reset Count from TX FIFO into OSR, keep RESET LOW
    mov isr, osr        side 0  ; Save Reset Count permanently in ISR, keep RESET LOW

    pull block          side 0  ; Pull Pulse Count from TX FIFO, keep RESET LOW

.wrap_target
    ; --- PHASE 1: RESET PHASE ---
    mov x, isr          side 0  ; Copy Reset Count into X; Set RESET pin LOW
reset_loop:
    jmp x-- reset_loop  side 0  ; Hold RESET LOW for the reset duration

    ; --- PHASE 2: SETTLE (reset released, no pulses yet) ---
    ; 20 PIO cycles total (scales with the PIO clock: 2 * dt at 50% duty).
    mov y, osr          side 1 [15] ; RESET HIGH; load pulse count (16 cycles)
    mov x, x            side 1 [3]  ; settle tail (4 cycles) -> 20 total

    ; --- PHASE 3: PULSE TRAIN (reset stays HIGH) ---
pulse_loop:
    set pins, 1 [4]     side 1  ; Drive CONV_START HIGH for 5 PIO cycles
    set pins, 0 [3]     side 1  ; Drive CONV_START LOW for 4 PIO cycles
    jmp y-- pulse_loop  side 1  ; 1 cycle for jump = 5 cycles LOW (10 cycles total per pulse)
.wrap

; NOTE (pindirs): this program never sets pin directions, so the C side must
; call pio_sm_set_consecutive_pindirs() for PIN_RESET and PIN_CONV_START
; after pio_sm_init() — otherwise the PIO never drives the pads (they stay
; Hi-Z even with the function select on PIO).
;
; Process (v2, bench comparison): reset LOW -> settle (20 cycles, reset
; HIGH) -> N pulses with edges at 0, dt, ..., (N-1)*dt after the settle ->
; the last pulse's period runs out, then the cycle wraps.  Period =
; (Reset + 1) + 20 + N*10 PIO cycles.
;
; Timing: one pulse = 10 PIO clock cycles; with clkdiv = clk_sys * dt_us / 1e7
; the pulse period is exactly dt. dt is bounded by the 16.8 clkdiv format
; (dt <= 65536 * 10 / clk_sys_MHz, ~4369 us at 150 MHz) — enforced by the
; 'P' command handler.
